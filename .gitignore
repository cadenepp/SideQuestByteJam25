# ===================================
# Global ignores
# ===================================
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws

# ===================================
# Front-End (Next.js)
# ===================================
Front-End/node_modules/
Front-End/.next/
Front-End/out/
Front-End/.turbo/
Front-End/.vercel/
Front-End/.eslintcache
Front-End/coverage/
Front-End/dist/
Front-End/npm-debug.log*
Front-End/yarn-debug.log*
Front-End/yarn-error.log*
Front-End/pnpm-debug.log*

# Local environment files
Front-End/.env*
!Front-End/.env.example

# ===================================
# Back-End (Spring Boot)
# ===================================
# Build output
Back-End/target/
Back-End/build/
Back-End/out/
Back-End/bin/
Back-End/.gradle/
Back-End/.mvn/
Back-End/mvnw
Back-End/mvnw.cmd

# Dependency directories
Back-End/node_modules/
Back-End/.sass-cache/
Back-End/.cache/
Back-End/dist/

# Logs
Back-End/*.log
Back-End/logs/
Back-End/tmp/
Back-End/temp/

# OS files
Back-End/.DS_Store
Back-End/Thumbs.db

# Local environment or config files
Back-End/.env*
!Back-End/.env.example

# ===================================
# Optional (if you use Docker)
# ===================================
**/docker-compose.override.yml
**/Dockerfile.local
**/.docker/

# ===================================
# Optional (if using test reports)
# ===================================
**/test-output/
**/reports/